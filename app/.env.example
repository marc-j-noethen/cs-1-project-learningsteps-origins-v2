# Copy this file to .env and replace the placeholders locally.
# The app refuses to start if the security-sensitive values stay empty.

APP_ENV=development
SWB_APP_NAME=SWB | Second-Workshop-Brain

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=second_workshop_brain
DATABASE_URL=postgresql://postgres:change-me-locally@postgres:5432/second_workshop_brain

SWB_ADMIN_USERNAME=swb-admin
SWB_ADMIN_PASSWORD=
SWB_ADMIN_PASSWORD_HASH=
SESSION_SECRET=

SWB_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SWB_SESSION_HTTPS_ONLY=false
SWB_SESSION_MAX_AGE_SECONDS=43200
SWB_SEED_DEMO_DATA=true
SWB_ENABLE_DOCS=true
SWB_MAX_REQUEST_SIZE=65536
SWB_LOGIN_RATE_LIMIT=5
SWB_WRITE_RATE_LIMIT=45
